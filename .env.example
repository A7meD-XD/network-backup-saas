# Generate a stable key with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DEVICE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
# Generate a separate value with: openssl rand -hex 32
# Required only to register an Admin via /auth/register.
ADMIN_REGISTRATION_TOKEN=replace-with-a-separate-random-bootstrap-token
# Compose builds DATABASE_URL from these PostgreSQL settings.
POSTGRES_DB=network_backup
POSTGRES_USER=network_backup
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
APP_PORT=8000
BACKUP_INTERVAL_HOURS=24

# Optional natural-language diff summaries. The unified diff is sent to Google's Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Realtime alerts (each channel is optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Scheduled daily/weekly email report. Use port 587 with STARTTLS or port 465 with SMTP_USE_SSL=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAILS=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Report schedule is interpreted in UTC.
REPORT_FREQUENCY=daily
REPORT_DAY_OF_WEEK=mon
REPORT_HOUR=8
REPORT_MINUTE=0
